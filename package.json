{
  "name": "deepinfra-fusion-proxy",
  "version": "2.1.0",
  "description": "Local reverse proxy for the DeepInfra API (injects service_tier/fail_fast, falls back between Standard and Flex with per-session cooldown locks), shipped as a DSH profile bundle with a per-session composer toggle, a status-first configuration page and one-click updates.",
  "type": "commonjs",
  "main": "plugin/deepinfra-proxy.mjs",
  "icon": "icon.svg",
  "exports": {
    ".": "./plugin/deepinfra-proxy.mjs",
    "./client": "./client/index.js",
    "./server.js": "./server.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "server.js",
    "cordis.patch.yml",
    "plugin",
    "client",
    "config",
    "locale",
    "icon.svg",
    "test-mock-upstream.js",
    "test/run-wait-test.js",
    "test/deepinfra-proxy-bundle-test.mjs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server.js",
    "test": "node test/deepinfra-proxy-bundle-test.mjs && node test/run-wait-test.js"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.7-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-rc.1 <0.3.0"
  },
  "keywords": [
    "deepinfra",
    "proxy",
    "openai",
    "flex",
    "priority",
    "service-tier",
    "fallback",
    "llm",
    "dsh",
    "dsh-bundle",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/citydirector/deepinfra-fusion-proxy.git"
  }
}
